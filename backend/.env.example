FLASK_ENV=development
FLASK_SECRET_KEY=dev-secret-change-in-production
JWT_SECRET_KEY=jwt-dev-secret-change-in-production
DATABASE_URL=mysql+pymysql://root@localhost:3306/nekedem
# Stripe.js receives only the publishable key from `/api/v1/stripe/config`.
# `SECRET_KEY` and `PUBLISHABLE_KEY` are also accepted for compatibility.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
# Set this to the webhook signing secret so payment_intent.succeeded events can
# finalize checkouts whose browser never returned from an SCA redirect. When it
# is unset the /api/v1/webhooks/stripe endpoint only acknowledges the event.
# STRIPE_ENDPOINT_SECRET=whsec_change_me
